# Palaver local service topology.
# Copy to .env for Honcho or shell-based local startup.
# Keep full URL values explicit; not every dotenv consumer expands nested variables.

# OpenCode server used by thin-client mode and by FastAPI as its upstream.
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=18000
OPENCODE_URL=http://127.0.0.1:18000
PALAVER_OPENCODE_SERVER_URL=http://127.0.0.1:18000

# FastAPI control-plane backend used when palaver.control_plane is enabled.
PALAVER_BACKEND_HOST=127.0.0.1
PALAVER_BACKEND_PORT=15000
PALAVER_BACKEND_URL=http://127.0.0.1:15000

# Self-hosted Convex backend and Vite's browser-facing Convex route.
PALAVER_CONVEX_HOST=127.0.0.1
PALAVER_CONVEX_PORT=3210
PALAVER_CONVEX_BACKEND_URL=http://127.0.0.1:3210
VITE_CONVEX_URL=http://127.0.0.1:5173/convex

# Palaver UI dev server.
PALAVER_WEB_HOST=127.0.0.1
PALAVER_WEB_PORT=5173
